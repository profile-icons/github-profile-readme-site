---
import OrgBadges from "../components/LinkOrgBadges.astro";
import IconLinks from "../components/LinkSiteIcons.astro";
import ProfileAvatar from "../components/ProfileAvatar.astro";
import ToggleLocale from "../components/ToggleLocale.astro";
import ToggleTheme from "../components/ToggleTheme.astro";
import {
  githubAvatarUrl,
  githubProfileUrl,
  localeSrc,
  locales,
  siteConfig,
} from "../config";
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchAvatar } from "../lib/fav";
import { fetchOrgs } from "../lib/gh";
import { getIconLinks, idUrls } from "../lib/links";
import { getTranslations } from "../lib/profile";
import { resolveTheme, resolveThemeColor, type ThemeType } from "../lib/theme";

const {
  description,
  githubName,
  links,
  organizations: orgNames,
  tabName,
  theme,
  themeColor,
  style,
} = siteConfig;
const themeType: ThemeType = resolveTheme(theme);
const resolvedThemeColor: string | undefined = resolveThemeColor(themeColor);
const isToggleTheme: boolean = !(
  themeType.type === "default" && resolvedThemeColor
);
const isToggleLocale: boolean = locales.length > 1;
const [profileSrc, favUrl, iconLinks, orgBadges] = await Promise.all([
  getTranslations(localeSrc),
  fetchAvatar(githubAvatarUrl),
  getIconLinks(links),
  fetchOrgs(orgNames ?? []),
]);

const srcTrans = {
  locale: localeSrc,
  title: profileSrc.title,
  tagline: profileSrc.tagline,
  readmeHTML: profileSrc.readme.html,
};

const url: URL = new URL(Astro.url.pathname, Astro.site);
const sameAs: string[] = [...new Set([githubProfileUrl, ...idUrls(iconLinks)])];

const structData = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: url.href,
  name: profileSrc.title,
  ...(description && { description }),

  mainEntity: {
    "@type": "Person",
    name: tabName,
    alternateName: githubName,
    ...(description && { description }),
    image: githubAvatarUrl,
    url: url.href,
    sameAs,
  },
};
---

<BaseLayout
  title={profileSrc.title}
  description={description}
  url={url}
  imageUrl={githubAvatarUrl}
  imageAlt={`${tabName}'s GitHub profile photo`}
  language={localeSrc}
  theme={theme}
  themeColor={themeColor}
  style={style}
  data={structData}
  favUrl={favUrl}
  locales={locales}
  srcTrans={srcTrans}
  defLanguage={localeSrc}
>
  <main
    class="content-shell relative mx-auto min-h-screen max-w-4xl px-5 py-10 sm:px-8 sm:py-16"
  >
    {(isToggleTheme || isToggleLocale) && (
        <div class="profile-controls">
          {isToggleTheme && <ToggleTheme />}
          {isToggleLocale && <ToggleLocale />}
        </div>
    )}

    <ProfileAvatar
      imageUrl={githubAvatarUrl}
      profileUrl={githubProfileUrl}
      tabName={tabName}
      tagline={profileSrc.tagline}
    />

    <IconLinks links={iconLinks} />

    <OrgBadges orgBadges={orgBadges} />

    <article
      class="gh-readme prose max-w-none"
      data-i18n-readme
      set:html={profileSrc.readme.html}
    />
  </main>
</BaseLayout>
---
