{
  "name": "github-profile-readme-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "i18n": "node scripts/i18n-trans.mjs",
    "dev": "npm run i18n && astro dev",
    "build": "npm run i18n && astro build",
    "preview": "astro preview",
    "verify": "biome check . && astro check",
    "verify:fix": "biome check --write . && astro check"
  },
  "overrides": {
    "sharp": "0.35.4"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@huggingface/transformers": "^3.8.1",
    "astro": "^7.3.2",
    "bootstrap-icons": "^1.13.1",
    "clean": "^4.0.2",
    "emoji-regex": "^10.6.0",
    "marked": "^18.0.12",
    "simple-icons": "^16.30.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.21.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true
  }
}
